{%- comment -%}
  T-0651: the agent feed's CVEs chunk. Every row of the /wire/ CVEs tab (significant new
  CVEs on neither VulnCheck KEV nor CISA KEV), all fields, one object per row. The shape
  guard is the page's own (a CVE id in CVE shape), so "count" equals the tab's row count.
  Field meanings live in /wire/agent/index.json.
{%- endcomment -%}
{%- assign wire = site.data.wire -%}
{%- assign c_rows = "" | split: "" -%}
{%- for r in wire.cves -%}{%- assign c_head = r.cve | slice: 0, 4 -%}{%- if c_head == "CVE-" -%}{%- assign c_rows = c_rows | push: r -%}{%- endif -%}{%- endfor -%}
