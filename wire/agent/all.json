---
layout: none
permalink: /wire/agent/all.json
sitemap: false
---
{%- comment -%}
  T-0651: the whole agent feed in one file: the kevs, cves and news chunks with the same
  rows, guards and fields (wire-agent-row.html), for an agent that can take it in one
  read. The split files exist for agents that cannot; index.json says which to use.
{%- endcomment -%}
{%- assign wire = site.data.wire -%}
{%- assign k_rows = "" | split: "" -%}
{%- for r in wire.vulns -%}{%- if r.cve and r.added -%}{%- assign k_head = r.cve | slice: 0, 4 -%}{%- assign k_alen = r.added | size -%}{%- if k_head == "CVE-" and k_alen == 10 -%}{%- assign k_rows = k_rows | push: r -%}{%- endif -%}{%- endif -%}{%- endfor -%}
{%- assign c_rows = "" | split: "" -%}
{%- for r in wire.cves -%}{%- assign c_head = r.cve | slice: 0, 4 -%}{%- if c_head == "CVE-" -%}{%- assign c_rows = c_rows | push: r -%}{%- endif -%}{%- endfor -%}
{"dataset": "all", "description": "The Wire agent feed in one file: kevs (CVEs newly added to VulnCheck KEV), cves (significant new CVEs on neither KEV list) and news (headlines). The same rows as kevs.json, cves.json and news.json. Field meanings: /wire/agent/index.json.", "index": {{ "/wire/agent/index.json" | absolute_url | jsonify }}, "generated_at": {{ wire.generated_at | date_to_xmlschema | jsonify }}, "window_days": {{ wire.window_days | jsonify }},
"kevs": {"generated_at": {{ wire.vulns_generated_at | jsonify }}, "status": {{ wire.vulns_status | jsonify }}, "count": {{ k_rows.size | jsonify }}, "counts": {{ wire.vulns_counts | jsonify }}, "detection_sources_checked_at": {{ wire.vulns_detect_at | jsonify }}, "top_vendors": {{ wire.vuln_vendors | jsonify }}, "rows": [
{%- for r in k_rows -%}{%- unless forloop.first -%},{%- endunless %}
{% include wire-agent-row.html r=r list="kev" -%}
{%- endfor %}
]},
"cves": {"generated_at": {{ wire.cves_generated_at | jsonify }}, "status": {{ wire.cves_status | jsonify }}, "count": {{ c_rows.size | jsonify }}, "counts": {{ wire.cves_counts | jsonify }}, "top_vendors": {{ wire.cve_vendors | jsonify }}, "rows": [
{%- for r in c_rows -%}{%- unless forloop.first -%},{%- endunless %}
{% include wire-agent-row.html r=r list="cve" -%}
{%- endfor %}
]},
"news": {"count": {{ wire.items.size | jsonify }}, "counts": {{ wire.counts | jsonify }}, "topics": {{ wire.topics | jsonify }}, "items": [
{%- for i in wire.items -%}{%- unless forloop.first -%},{%- endunless %}
{"title": {{ i.title | jsonify }}, "url": {{ i.url | jsonify }}, "source": {{ i.source | jsonify }}, "date": {{ i.date | date_to_xmlschema | jsonify }}, "kind": {{ i.kind | jsonify }}, "labels": {{ i.labels | jsonify }}}
{%- endfor %}
]}}
