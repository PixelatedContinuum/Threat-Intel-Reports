---
layout: none
permalink: /wire/vulns.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  The Wire's nKEVs tab (was Vulnerabilities, renamed in T-0468) as an Atom feed: one entry per CVE VulnCheck
  added to its Known Exploited Vulnerabilities catalog in the window, newest
  first, from the same `vulns:` rows /wire/ renders (_data/wire.yml, written by
  wire_export.py from VulnCheck's API). Each entry links to its row on /wire/.
  There is no description: the rows carry none, by the Wire's rule. The
  subtitle carries the VulnCheck attribution the tab's callout carries.
  Without vulnerability data this is a valid, empty feed rather than a 404.
  Built in T-0396; reports, ET Open and Nuclei pointers added in T-0407;
  T-0468 puts the disclosure day, the gap and EPSS in each summary: data
  fields only, still no description.
{%- endcomment -%}
{%- assign wire = site.data.wire %}
{%- assign sev_bands = "critical,high,medium,low" | split: "," %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}: The Wire, nKEVs (new known exploited vulnerabilities)</title>
  <subtitle>This feed shows VulnCheck's Known Exploited Vulnerabilities (KEV) catalog as VulnCheck publishes it. I do not curate or track this data myself; every entry comes from VulnCheck, and their catalog is at vulncheck.com/kev.</subtitle>
  <link href="{{ site.url }}/wire/vulns.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/wire/#vulns" rel="alternate" type="text/html"/>
  <link href="https://www.vulncheck.com/kev" rel="via" type="text/html" title="VulnCheck KEV"/>
  <updated>{% if wire and wire.vulns_generated_at and wire.vulns_generated_at != "" %}{{ wire.vulns_generated_at | date_to_xmlschema }}{% elsif wire and wire.generated_at %}{{ wire.generated_at | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <id>{{ site.url }}/wire/vulns.xml</id>
  <author>
    <name>VulnCheck</name>
    <uri>https://www.vulncheck.com/kev</uri>
  </author>
  <rights>Data from VulnCheck's Known Exploited Vulnerabilities catalog.</rights>
{%- if wire and wire.vulns and wire.vulns != empty %}
  {%- if wire.vulns_status == "ok" or wire.vulns_status == "stale" %}
  {%- for r in wire.vulns limit: 500 %}
  {%- comment %} The page's row guard: an empty string is true in Liquid, so check shapes. {% endcomment %}
  {%- assign vok = false %}
  {%- if r.cve and r.added %}{% assign cve_head = r.cve | slice: 0, 4 %}{% assign added_len = r.added | size %}{% if cve_head == "CVE-" and added_len == 10 %}{% assign vok = true %}{% endif %}{% endif %}
  {%- if vok %}
  {%- assign vday = r.added %}
  {%- assign cisa_len = r.cisa_added | size %}
  <entry>
    <title>{{ r.cve | xml_escape }}{% if r.vendor and r.vendor != "" %}: {{ r.vendor | xml_escape }} {{ r.product | xml_escape }}{% endif %}</title>
    <link href="{{ site.url }}/wire/#cve-{{ r.cve | downcase }}" rel="alternate" type="text/html"/>
    <link href="https://nvd.nist.gov/vuln/detail/{{ r.cve }}" rel="related" type="text/html" title="NVD"/>
    {%- comment %} T-0407: the reports VulnCheck cites as evidence of exploitation, and a public Nuclei template. {% endcomment %}
    {%- for rp in r.reports limit: 3 %}{% assign rp_head = rp.url | slice: 0, 8 %}{% if rp_head == "https://" %}
    <link href="{{ rp.url | xml_escape }}" rel="related" type="text/html" title="Reported by {{ rp.host | xml_escape }}"/>{% endif %}
    {%- endfor %}
    {%- assign nu_len = r.nuclei | size %}
    {%- if nu_len > 0 %}
    <link href="https://github.com/projectdiscovery/nuclei-templates/blob/main/{{ r.nuclei | xml_escape }}" rel="related" type="text/html" title="Nuclei template"/>
    {%- endif %}
    <id>{{ site.url }}/wire/#cve-{{ r.cve | downcase }}</id>
    <published>{{ vday }}T00:00:00Z</published>
    <updated>{{ vday }}T00:00:00Z</updated>
    <category term="vulncheck-kev" label="VulnCheck KEV"/>
    {%- if cisa_len == 10 %}
    <category term="cisa-kev" label="CISA KEV"/>
    {%- endif %}
    {%- assign n_sids = r.et_sids | size %}
    {%- if n_sids > 0 %}
    <category term="et-open-rule" label="ET Open rule"/>
    {%- endif %}
    {%- if nu_len > 0 %}
    <category term="nuclei-template" label="Nuclei template"/>
    {%- endif %}
    {%- assign cvss_len = r.cvss | size %}
    {%- assign sev = "" %}
    {%- if cvss_len > 0 %}{% if sev_bands contains r.severity %}{% assign sev = r.severity %}{% endif %}{% endif %}
    {%- if sev != "" %}
    <category term="severity-{{ r.severity | xml_escape }}" label="CVSS {{ r.severity | upcase | xml_escape }} {{ r.cvss | xml_escape }}"/>
    {%- endif %}
    {%- assign gap_str = r.gap | append: "" %}{% assign gap_len = gap_str | size %}{% assign gap_n = 0 %}{% if gap_len > 0 %}{% assign gap_n = r.gap | plus: 0 %}{% endif %}
    {%- assign dis_len = r.disclosed | append: "" | size %}{% assign epss_len = r.epss | append: "" | size %}
    <summary type="text">{% if dis_len == 10 %}Disclosed {{ r.disclosed | xml_escape }}; added{% else %}Added{% endif %} to VulnCheck KEV {{ vday }}{% if dis_len == 10 and gap_len > 0 %} ({% if gap_n > 0 %}+{% endif %}{{ gap_n }} day{% if gap_n != 1 and gap_n != -1 %}s{% endif %}){% endif %}{% if epss_len > 0 %}; EPSS {{ r.epss | times: 1.0 | round: 3 }}{% endif %}{% if cisa_len == 10 %}; in CISA KEV since {{ r.cisa_added }}{% endif %}{% if sev != "" %}; CVSS v{{ r.cvss_version | xml_escape }} {{ r.cvss | xml_escape }} {{ r.severity | upcase | xml_escape }}, scored by {% if r.scored_by == "NVD" %}NVD{% elsif r.scored_by == "ADP" %}CISA's ADP{% else %}the CNA{% endif %} (VulnCheck NVD++){% endif %}.</summary>
  </entry>
  {%- endif %}
  {%- endfor %}
  {%- endif %}
{%- endif %}
</feed>
