---
layout: none
permalink: /hunting-detections/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  The detection library as its own Atom feed: every published detection page,
  newest first, so a detection engineer can follow new rules without the
  reports. Same shape and the same publication rule as /feed.xml (site.pages
  under /hunting-detections/, never an unlisted page); the entry's updated time
  follows the page's date, since detection pages carry no last_updated.
{%- endcomment -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}: Detection Rules</title>
  {%- assign feed_sponsors = site.data.sponsors.sponsors | where: "tier", "monthly" | where: "active", true -%}
  <subtitle>Sigma, YARA and Suricata detection rules from original research, one page per campaign, licensed CC BY 4.0.{% if feed_sponsors.size > 0 %} Supported by {% for s in feed_sponsors %}{{ s.name | xml_escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}.{% endif %}</subtitle>
  <link href="{{ site.url }}/hunting-detections/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/hunting-detections/" rel="alternate" type="text/html"/>
  <link href="{{ site.url }}/feed.xml" rel="related" type="application/atom+xml" title="{{ site.title | xml_escape }}: reports"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/hunting-detections/</id>
  <author>
    <name>{{ site.title | xml_escape }}</name>
    <uri>{{ site.url }}</uri>
  </author>

  {% assign reports = site.pages
     | where_exp: "page", "page.url contains '/hunting-detections/'"
     | where_exp: "page", "page.layout == 'post'"
     | where_exp: "page", "page.title != nil"
     | where_exp: "page", "page.date != nil"
     | where_exp: "page", "page.unlisted != true"
     | sort: "date" | reverse %}

  {% for report in reports limit:20 %}
  <entry>
    <title>{{ report.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ report.url }}" rel="alternate" type="text/html"/>
    <published>{{ report.date | date_to_xmlschema }}</published>
    <updated>{{ report.last_updated | default: report.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ report.url }}</id>
    <author>
      <name>{{ site.title | xml_escape }}</name>
      <uri>{{ site.url }}</uri>
    </author>
    {% if report.description %}
    <summary type="text">{{ report.description | xml_escape }}</summary>
    {% else %}
    <summary type="text">{{ report.content | strip_html | truncate: 500 | xml_escape }}</summary>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
