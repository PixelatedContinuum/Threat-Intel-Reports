{%- comment -%} Concept 3 masthead (T-0556 w2): the thin top line (when the Wire last refreshed, today's date), then the full logo lockup (mark, rule, stacked wordmark; the same as the bar's, drawn larger) and the tagline. It scrolls away in the page flow; the .hl-nav bar below it is the part that stays pinned
  (position: sticky, assets/css/custom.scss), so the phone auto-hide and --hl-nav-vis act on the bar exactly as before. The date is the build's, refreshed to the reader's own day by the small script in _layouts/default.html. The logo is the page's h1 on the home page only. The bar's small mark shows once the masthead has scrolled away (class hl-nav--atmast, set in _layouts/default.html). {%- endcomment -%}
{%- assign _wire_t = site.data.wire.generated_at -%}
<div class="hl-mast">
  <div class="hl-mast__inner">
    <div class="hl-mast__top">
      <span class="hl-mast__live">{% if _wire_t %}<a href="{{ '/wire/' | relative_url }}">The Wire</a> updated {{ _wire_t | date: "%H:%M" }} UTC{% else %}<a href="{{ '/wire/' | relative_url }}">The Wire</a>{% endif %}</span>
      <span class="hl-mast__date" id="hl-mast-date">{{ site.time | date: "%A %-d %B %Y" }}</span>
    </div>
    <div class="hl-mast__main">
      {% if page.url == '/' %}<h1 class="hl-mast__logo">{% else %}<div class="hl-mast__logo">{% endif %}<a class="hl-mast__brand" href="{{ '/' | relative_url }}" aria-label="The Hunter&#8217;s Ledger, home">
        <svg class="hl-brand__icon" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="14" fill="#161b22"/><rect x="1" y="1" width="62" height="62" rx="13" fill="none" stroke="#30363d" stroke-width="1.5"/><g stroke="#58a6ff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M19 16 V48 M35 16 V48 M19 32 H35"/><path d="M35 48 H50"/></g></svg>
        <span class="hl-brand__rule" aria-hidden="true"></span>
        <span class="hl-brand__stack">
          <span class="hl-brand__top">THE HUNTER&#8217;S</span>
          <span class="hl-brand__main">LEDGER<span class="hl-brand__dot" aria-hidden="true"></span></span>
        </span>
      </a>{% if page.url == '/' %}</h1>{% else %}</div>{% endif %}
      <p class="hl-mast__tag">Original malware and infrastructure research, with the detections and indicators to act on it. Free, no paywall.</p>
    </div>
  </div>
</div>
<header class="hl-nav">
  <button class="hl-nav__menu" type="button" aria-controls="hl-drawer" aria-expanded="false" aria-label="Open menu">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    <span class="hl-nav__menu-label">Menu</span>
  </button>
  <a class="hl-nav__brand" href="{{ '/' | relative_url }}" aria-label="The Hunter&#8217;s Ledger, home">
    <svg class="hl-brand__icon" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="14" fill="#161b22"/><rect x="1" y="1" width="62" height="62" rx="13" fill="none" stroke="#30363d" stroke-width="1.5"/><g stroke="#58a6ff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M19 16 V48 M35 16 V48 M19 32 H35"/><path d="M35 48 H50"/></g></svg>
    <span class="hl-brand__rule" aria-hidden="true"></span>
    <span class="hl-brand__stack">
      <span class="hl-brand__top">THE HUNTER&#8217;S</span>
      <span class="hl-brand__main">LEDGER<span class="hl-brand__dot" aria-hidden="true"></span></span>
    </span>
  </a>
  {%- comment -%} Design D (T-0500.1.7.4): the six sections a reader reaches most, inline from 1100px, each with its section hue on the active/hover underline. The drawer
    below stays the full list (and the only list on a phone); these are real anchors in the HTML at every width. {%- endcomment -%}
  <nav class="hl-nav__sections" aria-label="Site sections">
    <a href="{{ '/reports/' | relative_url }}" style="--sc:#a371f7"{% if page.url contains '/reports/' %} aria-current="page"{% endif %}>Reports</a>
    <a href="{{ '/hunting-detections/' | relative_url }}" style="--sc:#4ade80"{% if page.url contains '/hunting-detections/' %} aria-current="page"{% endif %}>Detections</a>
    <a href="{{ '/ioc-feeds/' | relative_url }}" style="--sc:#f87171"{% if page.url contains '/ioc-feeds/' %} aria-current="page"{% endif %}>IOC feeds</a>
    <a href="{{ '/stix/' | relative_url }}" style="--sc:#22d3ee"{% if page.url contains '/stix/' %} aria-current="page"{% endif %}>STIX</a>
    <a href="{{ '/wire/' | relative_url }}" style="--sc:#58a6ff"{% if page.url contains '/wire/' %} aria-current="page"{% endif %}>The Wire</a>
    <a href="{{ '/actors/' | relative_url }}" style="--sc:#e879f9"{% if page.url contains '/actors/' %} aria-current="page"{% endif %}>Actors</a>
    <a href="{{ '/techniques/' | relative_url }}" style="--sc:#fb923c"{% if page.url contains '/techniques/' %} aria-current="page"{% endif %}>Techniques</a>
  </nav>
  {%- comment -%} A plain GET form posting ?q= to /search/, which reads the parameter and
    runs the query, so the bar itself loads no search script. The magnifier is a <label>
    for the input: on phones the field collapses to the icon and clicking it focuses
    (and so expands) the field. Enter submits. {%- endcomment -%}
  <form class="hl-nav__search" action="{{ '/search/' | relative_url }}" method="get" role="search" aria-label="Search the site">
    <label class="hl-nav__search-icon" for="hl-nav-q" title="Search the Ledger">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </label>
    <input class="hl-nav__search-input" id="hl-nav-q" name="q" type="search" placeholder="Search the Ledger" aria-label="Search the site" autocomplete="off" spellcheck="false">
  </form>
</header>
{%- comment -%}
  Site navigation lives in a drawer that slides in from the left (assets/js/nav-drawer.js).
  The primary group is driven by `position:` front matter exactly as the old bar was, so
  adding a section is still one key on its page. The second group is the set of pages the
  footer also carries. Links are real anchors in the HTML whether or not the drawer is open,
  so crawlers and a reader without JavaScript (the footer repeats them) lose nothing.
{%- endcomment -%}
<div class="hl-drawer__backdrop" id="hl-drawer-backdrop" hidden></div>
<nav class="hl-drawer" id="hl-drawer" aria-label="Site navigation" aria-hidden="true" hidden>
  <div class="hl-drawer__head">
    <span class="hl-drawer__title">Menu</span>
    <button class="hl-drawer__close" type="button" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
    </button>
  </div>
  <div class="hl-drawer__group">
    <div class="hl-drawer__label">Explore</div>
    {%- assign nav_pages = site.pages | where_exp: "item", "item.position" | sort: 'position' -%}
    {%- for nav_page in nav_pages -%}
      {%- unless nav_page.title == null or nav_page.hide or nav_page.title == site.title -%}
    {%- case nav_page.url -%}
      {%- when '/reports/' -%}{%- assign nav_sc = '#a371f7' -%}
      {%- when '/wire/' -%}{%- assign nav_sc = '#58a6ff' -%}
      {%- when '/actors/' -%}{%- assign nav_sc = '#e879f9' -%}
      {%- when '/techniques/' -%}{%- assign nav_sc = '#fb923c' -%}
      {%- when '/families/' -%}{%- assign nav_sc = '#2dd4bf' -%}
      {%- when '/impact/' -%}{%- assign nav_sc = '#fbbf24' -%}
      {%- when '/hunting-detections/' -%}{%- assign nav_sc = '#4ade80' -%}
      {%- when '/ioc-feeds/' -%}{%- assign nav_sc = '#f87171' -%}
      {%- when '/stix/' -%}{%- assign nav_sc = '#22d3ee' -%}
      {%- when '/subscribe/' -%}{%- assign nav_sc = '#58a6ff' -%}
      {%- when '/support/' -%}{%- assign nav_sc = '#e879f9' -%}
      {%- else -%}{%- assign nav_sc = '#9ca3af' -%}
    {%- endcase -%}
    <a class="hl-drawer__link" style="--sc:{{ nav_sc }}" href="{{ nav_page.url | relative_url }}"{% if page.url == nav_page.url %} aria-current="page"{% endif %}>{{ nav_page.nav_title | default: nav_page.title }}</a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  <div class="hl-drawer__group">
    <div class="hl-drawer__label">More</div>
    <a class="hl-drawer__link" style="--sc:#9ca3af" href="{{ '/search/' | relative_url }}"{% if page.url == '/search/' %} aria-current="page"{% endif %}>Search</a>
    <a class="hl-drawer__link" style="--sc:#9fb4c9" href="{{ '/consulting/' | relative_url }}"{% if page.url == '/consulting/' %} aria-current="page"{% endif %}>Consulting &amp; Advisory</a>
    <a class="hl-drawer__link" style="--sc:#d4a73a" href="{{ '/sponsor/' | relative_url }}"{% if page.url == '/sponsor/' %} aria-current="page"{% endif %}>Sponsorship</a>
    <a class="hl-drawer__link" style="--sc:#58a6ff" href="{{ '/about-me/' | relative_url }}"{% if page.url == '/about-me/' %} aria-current="page"{% endif %}>About Me</a>
    <a class="hl-drawer__link" style="--sc:#fb923c" href="{{ '/behind-the-reports/' | relative_url }}"{% if page.url == '/behind-the-reports/' %} aria-current="page"{% endif %}>Behind the Reports</a>
    <a class="hl-drawer__link" style="--sc:#9ca3af" href="{{ '/pgp/' | relative_url }}"{% if page.url == '/pgp/' %} aria-current="page"{% endif %}>PGP Key</a>
    <a class="hl-drawer__link" style="--sc:#9ca3af" href="{{ '/feed.xml' | relative_url }}">RSS Feed</a>
  </div>
</nav>
<script defer src="{{ '/assets/js/nav-drawer.js' | relative_url }}?v=1"></script>
<script defer src="{{ '/assets/js/search-clear.js' | relative_url }}?v=1"></script>
